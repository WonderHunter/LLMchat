# Copier en .env, ou lancer : uv run python scripts/init_env.py (depuis backend/)

# Signe les cookies de session (32 caractères minimum).
SECRET_KEY=
# Chiffre les clés API des utilisateurs en base. La perdre rend ces clés illisibles.
FERNET_KEY=

# Mettre à false pour fermer les inscriptions.
ALLOW_REGISTRATION=true
# Mettre à true quand l'app est servie en HTTPS.
COOKIE_SECURE=false

# Optionnelle. Sert uniquement à lire le catalogue de modèles OpenRouter, jamais au chat.
# Le catalogue est public : laisser vide fonctionne.
OPENROUTER_SERVICE_KEY=
# Fréquence de rafraîchissement du catalogue OpenRouter, en minutes.
CATALOG_REFRESH_MINUTES=30

# Déploiement Docker uniquement : nom de domaine pour lequel Caddy obtient le certificat HTTPS.
DOMAIN=
